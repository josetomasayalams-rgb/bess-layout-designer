# Optional. Preferred for high-quality Google satellite and hybrid basemaps.
# Restrict the browser key by domain in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional fallback. Enables MapTiler standard, satellite, and hybrid basemap styles.
# Keep real keys in .env.local; do not commit secrets.
NEXT_PUBLIC_MAPTILER_API_KEY=
